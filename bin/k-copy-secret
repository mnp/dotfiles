#!/bin/bash

set -eu

if [ $# -ne 2 ]; then
    echo Create a new secret with the contents of another.
    echo "Usage: $0 [source-namespace:]source-secret-name [target-namespace:]target-secret-name"
    exit 1
fi

source_namespace=""
source_secret="$1"
target_namespace=""
target_secret="$2"

IFS=':' read -ra source_parts <<< "$1"
if [ ${#source_parts[@]} -eq 2 ]; then
    source_namespace="-n ${source_parts[0]}"
    source_secret="${source_parts[1]}"
else
    source_secret="${source_parts[0]}"
fi

IFS=':' read -ra target_parts <<< "$2"
if [ ${#target_parts[@]} -eq 2 ]; then
    target_namespace="-n ${target_parts[0]}"
    target_secret="${target_parts[1]}"
else
    target_secret="${target_parts[0]}"
fi

# Parsing args was the stupid hard part. Now this is easy.

kubectl get secret $source_namespace $source_secret -o yaml \
    | yq "del(.metadata.uid, .metadata.creationTimestamp, .metadata.namespace, .metadata.resourceVersion),
        .metadata.name = \"$target_secret\"" \
    | kubectl apply -f - $target_namespace

