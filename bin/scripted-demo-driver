#!/usr/bin/env bash

# Bash comments are echoed
# Other lines are executed with a wait prompt afterward

input=${1?'Input script expected'}

wait_for_user() {		# prompt
    echo -n "$1 (>)"
    read -N1 -rs < /dev/tty
    echo
}

cat "$input" | while read line; do
    if [[ "$line" =~ ^#! ]]; then
	:
    elif [[ "$line" =~ ^$ ]]; then
	:
    elif [[ "$line" =~ ^# ]]; then
        wait_for_user "$line"
    else
	wait_for_user "$line"
	eval "$line"
    fi
done
